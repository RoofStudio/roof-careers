# URL do Web App do Google Apps Script (deploy "Anyone").
# Publica no bundle — nao e segredo, e so um endpoint que so sabe escrever.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# Cloudflare Turnstile — OPCIONAL. Sem isso o form funciona normalmente,
# so com honeypot + tempo minimo. A sitekey e publica por design; a SECRET
# fica em Script Properties do Apps Script e nunca chega ao cliente.
VITE_TURNSTILE_SITEKEY=
